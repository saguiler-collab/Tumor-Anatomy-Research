__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Downloaded inputs and generated results are reproducible from the pipeline and
# are far too large to version. `release/` IS committed — it is the deliverable.
#
# LEADING SLASH IS LOAD-BEARING. An unanchored `data/` matches a directory named
# `data` at ANY depth, which silently excluded the entire `ivygap/data/` Python
# package — the loader, the clinical parser, the portal reconciler and the downloader.
# The repository looked complete and was missing its whole data layer.
/data/
/results/

# Single-cell atlases are multi-GB build inputs, never outputs. Belt and braces on
# top of data/ above, so one landing outside that tree still cannot be committed.
*.h5ad
*.csv.gz
*.egg-info/
build/
dist/
results_synthetic/
release_synthetic/

# Superseded runs are preserved on disk rather than deleted, but only their WRITE-UP is
# worth versioning. The artefacts themselves are stale by definition — and in the
# 2026-09-03 case were a mixture of two runs — so the markdown that explains why they
# are superseded is tracked and the tables are not.
results_superseded/*/anatomic/
results_superseded/*/benchmark/
results_superseded/*/estimates/
results_superseded/*/figures/
results_superseded/*/survival/

# Vendored third-party R package sources (MuSiC, Bisque, SCDC, DWLS), ~242 MB. They are
# other people's code with their own licences and release channels; R/install_deps.R
# installs from here when present and falls back to CRAN/GitHub otherwise. Committing
# them would bloat the repo and blur whose code is whose.
pipeline packages /

# DWLS's cached MAST signature build, keyed on the cell export it came from.
dwls_signature_*/

# The results-tree lock. Runtime state, never versioned.
.run.lock

# Archived runs ARE committed. results/ is by definition what the next run overwrites;
# an archive is the citable snapshot, ~1 MB, with a hash for every file. This project
# has lost a completed run twice, so the durable copy lives in git rather than only on
# one disk. The _safety_* prefix marks an unverified mid-run copy — those are not
# citable and are not committed.
results_archive/_safety_*
